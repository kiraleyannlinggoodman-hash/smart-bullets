{
  "name": "smart-bullets",
  "version": "1.0.1",
  "private": true,
  "description": "A RemNote plugin that hides bullet markers without removing bullet-list structure.",
  "scripts": {
    "check-types": "tsc --noEmit",
    "dev": "cross-env NODE_ENV=development webpack-dev-server --color --progress --no-open",
    "build": "npx remnote-plugin validate && shx rm -rf dist && cross-env NODE_ENV=production webpack --color --progress && shx cp README.md dist && cd dist && bestzip ../PluginZip.zip ./*",
    "start": "http-server --cors -p 7000 dist -c-1",
    "sass": "sass --style=compressed --no-source-map src/scss/snippet.scss:src/snippet.css"
  },
  "dependencies": {
    "@remnote/plugin-sdk": "^0.0.46",
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "devDependencies": {
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.15",
    "@types/node": "^18.19.69",
    "@types/react": "^17.0.83",
    "@types/react-dom": "^17.0.26",
    "autoprefixer": "^10.4.20",
    "bestzip": "^2.2.1",
    "cross-env": "^7.0.3",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.11.0",
    "esbuild-loader": "^2.21.0",
    "glob": "^10.4.5",
    "html-webpack-plugin": "^5.6.3",
    "http-server": "^14.1.1",
    "mini-css-extract-plugin": "^2.9.2",
    "postcss": "^8.4.49",
    "postcss-import": "^14.1.0",
    "postcss-loader": "^7.3.4",
    "raw-loader": "^4.0.2",
    "react-refresh": "^0.14.2",
    "sass": "^1.83.1",
    "sass-loader": "^14.2.1",
    "shx": "^0.3.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^4.9.5",
    "webpack": "^5.97.1",
    "webpack-cli": "^4.10.0",
    "webpack-dev-server": "^4.15.2"
  }
}
